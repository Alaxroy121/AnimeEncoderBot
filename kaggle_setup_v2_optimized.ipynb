      "source": [
        "# Step 1: System Check\n",
        "import subprocess\n",
        "import os\n",
        "\n",
        "print('🔍 Checking system...')\n",
        "!nvidia-smi --query-gpu=name,memory.total --format=csv,noheader\n",
        "!ffmpeg -version 2>/dev/null | head -1 || echo 'FFmpeg found'\n",
        "print('✅ System ready')"
      ]
    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 2: Load Secrets (correct names)\",\n        \"import os\",\n        \"from kaggle_secrets import UserSecretsClient\",\n        \"\",\n        \"print('🔐 Loading secrets...')\",\n        \"user_secrets = UserSecretsClient()\",\n        \"\",\n        \"# Load all secrets with correct names\",\n        \"try:\",\n        \"    api_id = user_secrets.get_secret('API_ID')\",\n        \"    api_hash = user_secrets.get_secret('API_HASH')\",\n        \"    bot_token = user_secrets.get_secret('BOT_TOKEN')\",\n        \"    admin_ids = user_secrets.get_secret('ADMINS')  # Note: ADMINS not ADMIN_IDS\",\n        \"    log_channel = user_secrets.get_secret('LOG_CHANNEL')\",\n        \"    gdrive_folder = user_secrets.get_secret('GDRIVE_FOLDER_ID')\",\n        \"    gdrive_sa = user_secrets.get_secret('GDRIVE_SA_JSON')\",\n        \"\",\n        \"    # Set environment\",\n        \"    os.environ['API_ID'] = api_id\",\n        \"    os.environ['API_HASH'] = api_hash\",\n        \"    os.environ['BOT_TOKEN'] = bot_token\",\n        \"    os.environ['ADMIN_IDS'] = admin_ids\",\n        \"    os.environ['LOG_CHANNEL'] = log_channel\",\n        \"    os.environ['GDRIVE_FOLDER_ID'] = gdrive_folder\",\n        \"    os.environ['GDRIVE_SA_JSON'] = gdrive_sa\",\n        \"\",\n        \"    print('✅ All secrets loaded!')\",\n        \"except Exception as e:\",\n        \"    print(f'Error loading secrets: {e}')\",\n        \"    raise\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 3: Install Pyrogram\",\n        \"import subprocess\",\n        \"import sys\",\n        \"\",\n        \"print('📦 Installing Pyrogram...')\",\n        \"for pkg in ['pyrogram', 'tgcrypto', 'aiofiles', 'motor', 'pymongo']:\",\n        \"    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', pkg])\",\n        \"    print(f'  ✅ {pkg}')\",\n        \"print('✅ Done')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 4: Start MongoDB\",\n        \"import subprocess\",\n        \"import os\",\n        \"import time\",\n        \"\",\n        \"print('🗄️  Starting MongoDB...')\",\n        \"os.makedirs('/data/db', exist_ok=True)\",\n        \"\",\n        \"try:\",\n        \"    subprocess.Popen(['mongod', '--fork', '--logpath', '/tmp/mongod.log', '--dbpath', '/data/db'],\",\n        \"                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\",\n        \"    time.sleep(2)\",\n        \"    print('✅ MongoDB running')\",\n        \"except Exception as e:\",\n        \"    print(f'⚠️  MongoDB: {e}')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 5: Clone Bot\",\n        \"import subprocess\",\n        \"import os\",\n        \"\",\n        \"bot_dir = '/kaggle/working/bot'\",\n        \"if not os.path.exists(bot_dir):\",\n        \"    print('📥 Cloning bot...')\",\n        \"    subprocess.run(['git', 'clone', 'https://github.com/Alaxroy121/AnimeEncoderBot.git', bot_dir],\",\n        \"                  capture_output=True, timeout=60)\",\n        \"    print('✅ Bot cloned')\",\n        \"else:\",\n        \"    print('✅ Bot directory exists')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 6: Use Optimized Templates\",\n        \"import shutil\",\n        \"import os\",\n        \"\",\n        \"bot_dir = '/kaggle/working/bot'\",\n        \"\",\n        \"# Copy templates if they exist\",\n        \"if os.path.exists(f'{bot_dir}/bot_v2_pyrogram.py'):\",\n        \"    shutil.copy(f'{bot_dir}/bot_v2_pyrogram.py', f'{bot_dir}/bot.py')\",\n        \"    print('✅ Using Pyrogram template')\",\n        \"\",\n        \"if os.path.exists(f'{bot_dir}/encoder_v2_async.py'):\",\n        \"    shutil.copy(f'{bot_dir}/encoder_v2_async.py', f'{bot_dir}/encoder.py')\",\n        \"    print('✅ Using async encoder')\",\n        \"\",\n        \"# Install bot dependencies\",\n        \"import subprocess\",\n        \"import sys\",\n        \"subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-r', f'{bot_dir}/requirements.txt'],\",\n        \"              capture_output=True, timeout=120)\",\n        \"print('✅ Dependencies installed')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 7: Verify GPU\",\n        \"import subprocess\",\n        \"\",\n        \"print('🔍 GPU Verification:')\",\n        \"result = subprocess.run(['ffmpeg', '-encoders'], capture_output=True, text=True, timeout=10)\",\n        \"if 'hevc_nvenc' in result.stdout:\",\n        \"    print('✅ HEVC NVENC available (GPU encoding)')\",\n        \"else:\",\n        \"    print('⚠️  HEVC NVENC not available')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 8: Setup Directories\",\n        \"import os\",\n        \"\",\n        \"os.makedirs('/kaggle/working/downloads', exist_ok=True)\",\n        \"os.makedirs('/kaggle/working/encoded', exist_ok=True)\",\n        \"print('✅ Directories ready')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 9: Create config.env\",\n        \"import os\",\n        \"\",\n        \"bot_dir = '/kaggle/working/bot'\",\n        \"\",\n        \"api_id = os.getenv('API_ID')\",\n        \"api_hash = os.getenv('API_HASH')\",\n        \"bot_token = os.getenv('BOT_TOKEN')\",\n        \"admin_ids = os.getenv('ADMIN_IDS')\",\n        \"log_channel = os.getenv('LOG_CHANNEL', '')\",\n        \"gdrive_folder = os.getenv('GDRIVE_FOLDER_ID', '')\",\n        \"gdrive_sa = os.getenv('GDRIVE_SA_JSON', '')\",\n        \"\",\n        \"config = f\\\"\\\"\\\"API_ID={api_id}\",\n        \"API_HASH={api_hash}\",\n        \"BOT_TOKEN=***\",\n        \"ADMIN_IDS={admin_ids}\",\n        \"LOG_CHANNEL={log_channel}\",\n        \"GDRIVE_FOLDER_ID={gdrive_folder}\",\n        \"MONGO_URI=mongodb://localhost:27017/anime_encoder_bot\",\n        \"DOWNLOAD_DIR=/kaggle/working/downloads\",\n        \"ENCODE_DIR=/kaggle/working/encoded\",\n        \"GPU_ENABLED=true\",\n        \"CONCURRENT_TASKS=2\",\n        \\\"\\\"\\\"\",\n        \"\",\n        \"with open(f'{bot_dir}/config.env', 'w') as f:\",\n        \"    f.write(config)\",\n        \"\",\n        \"print('✅ config.env created')\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"# Step 10: Verify & Start Bot\",\n        \"import os\",\n        \"\",\n        \"bot_dir = '/kaggle/working/bot'\",\n        \"required = ['bot.py', 'config.py', 'database.py']\",\n        \"\",\n        \"print('✅ Final Verification:')\",\n        \"missing = []\",\n        \"for f in required:\",\n        \"    if os.path.exists(f'{bot_dir}/{f}'):\",\n        \"        print(f'  ✅ {f}')\",\n        \"    else:\",\n        \"        print(f'  ❌ {f}')\",\n        \"        missing.append(f)\",\n        \"\",\n        \"if not missing:\",\n        \"    print('\\\\n✅ All files ready. Starting bot...\\\\n')\",\n        \"    os.chdir(bot_dir)\",\n        \"    os.system('python bot.py')\",\n        \"else:\",\n        \"    print(f'\\\\n❌ Missing: {missing}')\"\n      ]\n    }\n  ],\n  \"metadata\": {\n    \"kernelspec\": {\n      \"display_name\": \"Python 3\",\n      \"language\": \"python\",\n      \"name\": \"python3\"\n    },\n    \"language_info\": {\n      \"name\": \"python\",\n      \"version\": \"3.10.0\"\n    }\n  },\n  \"nbformat\": 4,\n  \"nbformat_minor\": 4\n}
